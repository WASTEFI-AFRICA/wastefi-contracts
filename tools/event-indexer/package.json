{
  "name": "@wastefi/event-indexer",
  "version": "1.0.0",
  "description": "Event indexer for WasteFi smart contracts",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:init": "node scripts/init-db.js",
    "db:migrate": "node scripts/migrate.js",
    "backfill": "node dist/scripts/backfill.js",
    "retry-failed": "node dist/scripts/retry-failed.js"
  },
  "keywords": [
    "stellar",
    "soroban",
    "blockchain",
    "indexer",
    "events",
    "wastefi"
  ],
  "author": "WasteFi Team",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^11.0.0",
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "prom-client": "^15.0.0",
    "axios": "^1.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

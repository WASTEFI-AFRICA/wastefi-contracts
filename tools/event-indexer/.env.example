# Soroban RPC Configuration
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# WasteFi Contract Addresses
# Replace with actual deployed contract addresses
WASTE_TOKEN_CONTRACT=CA7Q...
COLLECTOR_REGISTRY_CONTRACT=CA8R...
COLLECTION_POINT_CONTRACT=CA9S...
WASTE_TRANSACTION_CONTRACT=CA10...
PAYMENT_DISTRIBUTION_CONTRACT=CA11...
REPUTATION_CONTRACT=CA12...
MATERIAL_PRICING_CONTRACT=CA13...

# Database Configuration
DATABASE_URL=postgresql://wastefi:password@localhost:5432/wastefi_events
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Indexing Configuration
POLL_INTERVAL=5000              # Poll every 5 seconds
BATCH_SIZE=100                  # Process 100 events per batch
START_LEDGER=auto               # 'auto' or specific ledger number
MAX_RETRIES=3                   # Retry failed events 3 times
RETRY_DELAY=60000               # Wait 60 seconds before retry

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=*               # Restrict in production

# Monitoring Configuration
METRICS_PORT=9090
METRICS_PATH=/metrics
LOG_LEVEL=info                  # debug, info, warn, error
LOG_FORMAT=json                 # json or text

# Features
ENABLE_WEBHOOKS=false
WEBHOOK_URL=https://your-app.com/webhook
ENABLE_REALTIME_WS=false
WS_PORT=3001

# Performance
WORKER_THREADS=1                # Number of parallel workers
ENABLE_CACHE=true
CACHE_TTL=300                   # Cache TTL in seconds

# Security (for production)
ENABLE_AUTH=false
API_KEY=your-secret-api-key
RATE_LIMIT=100                  # Requests per minute
